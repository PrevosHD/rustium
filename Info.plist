<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- WebKit only lets pages use the microphone and camera when the app declares why it needs them. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Web apps in rustium use the microphone for voice messages and calls.</string>
  <key>NSCameraUsageDescription</key>
  <string>Web apps in rustium use the camera for photos and video calls.</string>
</dict>
</plist>
